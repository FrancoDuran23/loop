# Deal Signal Engine — environment variables
#
# None of these are required. The zero-config bootstrap
# (`docker compose up -d && npm i && npm run db:migrate && npm run pipeline
# -- --thesis thesis.example.yaml`) works with NO .env file at all — every
# variable below has a default in src/config.ts (Zod-validated, fail-fast on
# an invalid value). Copy this file to `.env` only if you want to override a
# default.

# Which EmbeddingProvider the composition root (src/runtime.ts) selects.
#   local         — real sentence embeddings via transformers.js
#                   (Xenova/all-MiniLM-L6-v2, 384-dim). Downloads ~90MB on
#                   first run, then works offline. This is the pipeline's
#                   real default.
#   deterministic — fast, hash-based fake embeddings with no download and no
#                   model. Scoped to tests/CI only — never use this for a
#                   real run, the semantic-fit component becomes meaningless.
EMBEDDING_PROVIDER=local

# Which LlmProvider generates enrichment guesses + rationale text.
#   rules  — deterministic, template-based, zero external calls, zero cost.
#            The real default — the system is designed to work well with
#            this alone (see README "Decisions and trade-offs").
#   ollama — NOT IMPLEMENTED. Selecting this fails fast at startup
#            (src/runtime.ts) rather than silently falling back to rules.
LLM_PROVIDER=rules

# Postgres connection string. Defaults to docker-compose.yml's own local
# service credentials/port — override only to point at a non-default
# Postgres (staging, CI, a remote pgvector-enabled instance).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deal_signal_engine

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional. Raises the GitHub adapter's unauthenticated 60 req/h ceiling.
# Unset by default — the pipeline runs fully without it, just slower once
# the unauthenticated quota is exhausted (see README "Known limitations").
# GITHUB_TOKEN=

# HTTP port for `npm run serve` (src/api/server.ts).
PORT=3000
