{
  "name": "deal-signal-engine",
  "version": "0.1.0",
  "description": "Ingests, resolves, enriches and scores early-stage deal signals against a configurable investment thesis.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "pipeline": "tsx src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "verify:local-embeddings": "tsx scripts/verify-local-embeddings.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.1.8",
    "postgres": "^3.4.9",
    "psl": "^1.15.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
